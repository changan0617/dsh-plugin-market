{
  "name": "dsh-plugin-market",
  "version": "1.1.0",
  "description": "Plugin market button for the dsh web UI: one click opens dshmarket.com, the community plugin market for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.7-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/changan0617/dsh-plugin-market.git"
  },
  "homepage": "https://github.com/changan0617/dsh-plugin-market",
  "license": "MIT"
}
